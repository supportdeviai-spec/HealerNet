APP_NAME=HealerNet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://healernet.org
# APP_DOMAIN=healernet.org
# ASSET_URL=https://healernet.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Docker / production uses redis. WhatsApp Community imports use the isolated
# redis_imports connection + whatsapp-imports queue (see config/queue.php).
# WHATSAPP_IMPORT_MAX_FILE_KB=204800
# WHATSAPP_IMPORT_CHUNK_SIZE=500
# WHATSAPP_IMPORT_MAX_ROWS=1000000
# WHATSAPP_IMPORT_QUEUE=whatsapp-imports
# WHATSAPP_IMPORT_JOB_TIMEOUT=7200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Local Docker: use Mailpit (docker service "mailpit", UI at http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
# Production / Mailtrap / Gmail example:
# MAIL_URL=smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525?encryption=tls
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@healernet.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auth / CORS (local defaults). Production values are in .env.production.example
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000
SESSION_SECURE_COOKIE=false
